# Deploying on Render? Also set PYTHON_VERSION=3.12.6 (full version, no quotes) in the service's Environment.
# Without it Render picks its newest Python and the build fails on langchain-pinecone ("No matching distribution").

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here

# Resume analysis LLM backend (safety toggle):
#   dspy   (default) -> app/intelligence/dspy_modules.py (typed DSPy program)
#   legacy           -> prompt_loader + parse_llm_json_with_retry (old path)
# DSPy LM routing (only used when backend is dspy):
#   DSPY_MODEL / DSPY_BASE_URL default to openrouter @ http://localhost:20128/v1
RESUME_LLM_BACKEND=dspy

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key

# Direct PostgreSQL connection (Supabase Dashboard → Settings → Database → Connection string → URI)
# Used by both Alembic migrations and async SQLAlchemy engine
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Machines without IPv6 cannot reach Supabase's IPv6-only direct host (db.<ref>.supabase.co): use the IPv4 pooler URL above.

# LLM models. The default chain is Groq (reasoning_effort=low is set automatically) -> OpenRouter -> local gateway.
# Provider model lineups change; these override the Groq model ids without a code change.
GROQ_API_KEY=your_groq_key
GROQ_STRONG_MODEL=openai/gpt-oss-120b
GROQ_CHEAP_MODEL=openai/gpt-oss-20b

# Tests: the default `pytest` run is hermetic (DATABASE_URL is cleared). Set PYTEST_USE_DB=1 to run the db/integration tests.
# Browser end-to-end tests: `python tools/e2e/run.py` (add --pooler on an IPv4-only network).

# Optional: Set to true for debugging
DEBUG=false

# v4 session store backend: "memory" (default) or "redis"
SESSION_STORE_BACKEND=memory
# Redis connection URL (required when SESSION_STORE_BACKEND=redis).
# Same value powers the Redis cache in app/services/cache.py.
# Example: redis://:password@redis-12345.c10.us-west-2-1.ec2.cloud.redislabs.com:6379

# Resend (email delivery)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=AI Interview Agent
APP_URL=http://localhost:5173
# Local demo page only (frontend/public/demo.html "refresh DB"). Wipes interview sessions WITHOUT a login,
# so keep it false everywhere except your own machine.
DEMO_TOOLS_ENABLED=false
# Swagger UI (/docs), ReDoc (/redoc) and /openapi.json list every route. Unset = on locally, off when APP_URL is a
# deployed address. ENABLE_API_DOCS=true keeps them on in production (not recommended); false turns them off everywhere.
# ENABLE_API_DOCS=
# How many reverse proxies sit in front of the app (ngrok, a load balancer, a platform router); 0 = none.
# Behind a proxy, 0 makes the rate limiter treat every user as the proxy (one shared bucket). Set it to the
# real number of proxies, never higher: the real client is read from the right end of X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# ----- Anti-cheat guard (default OFF) -----
# Contract documented in docs/anti-cheat-guard.md.
# Keep DISABLED while developing/testing — the guard is designed to catch
# candidates who answer using AI tools; it will flag your own AI-assisted
# test answers too.
ANTI_CHEAT_GUARD_ENABLED=false
ANTI_CHEAT_LLM_JUDGE=true
ANTI_CHEAT_FLAG_THRESHOLD=70

# ----- Embeddings (company-document search + the question-similarity guard) -----
# auto (default) picks, in this order:
#   1. the local model all-MiniLM-L6-v2 (sentence-transformers) when it is installed AND the machine has ~400 MB spare;
#   2. Pinecone's free hosted embeddings (llama-text-embed-v2, 384 dimensions) when PINECONE_API_KEY is set  <- a 512 MB host;
#   3. the Hugging Face API when HF_TOKEN is set (needs pre-paid credits on a free account).
# Force one with: local | pinecone | hosted | off.
# Pinecone's model differs from MiniLM, so its vectors live in their own namespace (…__llama-text-embed-v2-384): documents must be
# indexed once with it, e.g.  EMBEDDING_BACKEND=pinecone python scripts/index_org_documents.py <org_id>
# and the question-similarity guard uses its text-only fallback with it (its threshold was tuned on MiniLM).
EMBEDDING_BACKEND=auto
# Local model on a small host: one PyTorch thread + a cache (default). false = the plain LangChain loader.
EMBEDDING_LOCAL_LEAN=true
# Memory the local model needs free before it is loaded (MB). Below this, auto uses Pinecone, or turns embeddings off.
EMBEDDING_LOCAL_MIN_FREE_MB=400
HF_TOKEN=
