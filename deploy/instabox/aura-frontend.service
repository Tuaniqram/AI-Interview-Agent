# ~/.config/systemd/user/aura-frontend.service  (serves the built frontend/dist; run `npm run build` first)
[Unit]
Description=AURA frontend (static build)
After=network.target

[Service]
WorkingDirectory=%h/AI-Interview-Agent/frontend
ExecStart=/usr/bin/env npx vite preview --host 0.0.0.0 --port 5173
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
