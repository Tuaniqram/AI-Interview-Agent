# ~/.config/systemd/user/aura-backend.service
[Unit]
Description=AURA backend (uvicorn)
After=network.target aura-redis.service redis-server.service
Wants=aura-redis.service

[Service]
WorkingDirectory=%h/AI-Interview-Agent
ExecStart=%h/AI-Interview-Agent/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=* --timeout-graceful-shutdown 30
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
